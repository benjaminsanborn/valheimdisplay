# Valheim world viewer -> ~/.config/systemd/user/valheimdisplay.service
# Finds the world/game/log itself, rebuilds when the server saves, serves on 127.0.0.1:8080 (Caddy in front).
# Settings: ~/valheimdisplay/valheimdisplay.toml.  Logs: journalctl --user -u valheimdisplay
[Unit]
Description=Valheim world viewer
After=network.target

[Service]
WorkingDirectory=%h/valheimdisplay
ExecStart=%h/.local/bin/uv run --frozen python tools/valheimdisplay.py --bind 127.0.0.1
Restart=on-failure
RestartSec=30
IOSchedulingClass=idle

[Install]
WantedBy=default.target
