# Example: serve the viewer on your own domain with HTTPS (the certificate is automatic).
# Install as /etc/caddy/sites/valheimdisplay.caddy (or paste into your Caddyfile), replace the
# domain, and run the viewer with --bind 127.0.0.1 so only Caddy can reach it.
valheim.example.com {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8080
	# public, but asks search engines not to index it
	header X-Robots-Tag "noindex, nofollow"
}
