# Valheim world viewer -> /etc/caddy/sites/valheimdisplay.caddy (imported by /etc/caddy/Caddyfile)
# HTTPS certificate is automatic. Public, but asks search engines not to index it.
# The viewer serves itself (deploy/valheimdisplay.service, 127.0.0.1:8080), including gzipped data and cache headers.
valheim.goku.host {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8080
	header X-Robots-Tag "noindex, nofollow"
}
