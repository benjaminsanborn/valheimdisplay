# Valheim world viewer -> /etc/caddy/sites/valheimdisplay.caddy (imported by /etc/caddy/Caddyfile)
# HTTPS certificate is automatic. The site holds art extracted from the game, so it sits behind a
# shared password: replace HASH with the output of `caddy hash-password` when installing.
valheim.benjaminsanborn.com, valheim.goku.host {
	basic_auth {
		friends HASH
	}
	root * /var/www/valheimdisplay
	encode zstd gzip
	file_server
	@data path /assets/regions/* /assets/worldmap.png /assets/models.json
	header @data Cache-Control "no-cache"
	header X-Robots-Tag "noindex, nofollow"
}
